{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": [
    "src/probeCoordinator.js",
    "src/webviewAssets.js",
    "src/services/**/*.js",
    "scripts/release.js",
    "scripts/run-tests.js",
    "test/hil/run-hil.js"
  ]
}
