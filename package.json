{
  "name": "emberprobe",
  "displayName": "EmberProbe - MCU Flash & Debug",
  "description": "Modern MCU flashing and debugging with OpenOCD, automatic target detection, live variables, and Agent Skills.",
  "version": "0.7.14",
  "publisher": "BakeSheep",
  "repository": {
    "type": "git",
    "url": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug.git"
  },
  "homepage": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug#readme",
  "bugs": {
    "url": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "MCU",
    "OpenOCD",
    "flash",
    "debug",
    "ELF",
    "SVD",
    "Cortex-M",
    "embedded",
    "agent"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "EmberProbe executes the configured OpenOCD tool and hardware scripts, so the workspace must be trusted."
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.agents/skills/mcu-variables/SKILL.md",
    "onView:mcu-vscode.mainView",
    "onDebugResolve:cortex-debug",
    "onCommand:mcu-vscode.folderDebug",
    "onCommand:mcu-vscode.folderDownload",
    "onCommand:mcu-vscode.openLiveWatch",
    "onCommand:mcu-vscode.manageAgentSkills",
    "onCommand:mcu-vscode.downloadOfficialSvd",
    "onCommand:mcu-vscode.selectExistingSvd",
    "onCommand:mcu-vscode.switchWorkspaceSvd",
    "onCommand:mcu-vscode.checkOpenOcd",
    "onDebugResolve:emberprobe"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcu-vscode-container",
          "title": "EmberProbe",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "mcu-vscode-container": [
        {
          "type": "webview",
          "id": "mcu-vscode.mainView",
          "name": "Flash & Debug"
        }
      ]
    },
    "commands": [
      {
        "command": "mcu-vscode.folderDebug",
        "title": "EmberProbe: 启动调试"
      },
      {
        "command": "mcu-vscode.folderDownload",
        "title": "EmberProbe: 下载程序"
      },
      {
        "command": "mcu-vscode.openLiveWatch",
        "title": "EmberProbe: 实时变量查看"
      },
      {
        "command": "mcu-vscode.checkOpenOcd",
        "title": "EmberProbe: 检查 OpenOCD 环境"
      },
      {
        "command": "mcu-vscode.manageAgentSkills",
        "title": "EmberProbe: 管理 Agent Skills"
      },
      {
        "command": "mcu-vscode.downloadOfficialSvd",
        "title": "EmberProbe: 下载/配置官方 SVD"
      },
      {
        "command": "mcu-vscode.selectExistingSvd",
        "title": "EmberProbe: 选择已有 SVD"
      },
      {
        "command": "mcu-vscode.switchWorkspaceSvd",
        "title": "EmberProbe: 切换当前工作区 SVD"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mcu-vscode.folderDebug",
          "group": "mcu-vscode@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "mcu-vscode.folderDownload",
          "group": "mcu-vscode@2",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "EmberProbe 配置",
      "properties": {
        "emberprobe.openocdPath": {
          "type": "string",
          "default": "openocd",
          "description": "OpenOCD >= 0.12.0 可执行文件路径；不在 PATH 时请填写绝对路径（如 /usr/bin/openocd 或 C:\\openocd\\bin\\openocd.exe）"
        },
        "emberprobe.tclPort": {
          "type": "number",
          "default": 6666,
          "description": "实时变量采样使用的 OpenOCD Tcl-RPC 端口；显式配置后固定使用该端口，未显式配置时自动选用随机临时端口（OpenOCD Tcl 端口无认证，建议保持随机）"
        },
        "emberprobe.sampleIntervalMs": {
          "type": "number",
          "default": 33,
          "minimum": 5,
          "maximum": 10000,
          "description": "旧版实时变量采样目标间隔（毫秒）；未设置采样频率时仍兼容此设置"
        },
        "emberprobe.sampleFrequencyHz": {
          "type": "number",
          "default": 30,
          "minimum": 0.1,
          "maximum": 200,
          "description": "实时变量目标采样频率（Hz），默认 30Hz；实际频率受探针吞吐能力自适应调控"
        },
        "emberprobe.maxSamples": {
          "type": "number",
          "default": 2000,
          "description": "实时曲线每个通道保留的最大采样点数"
        },
        "emberprobe.samplingArchiveMaxMiB": {
          "type": "number",
          "default": 1024,
          "minimum": 64,
          "maximum": 102400,
          "description": "当前扩展会话的自动采样历史最大磁盘占用（MiB），退出时自动删除"
        },
        "emberprobe.cubemxPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Standalone STM32CubeMX executable path (Windows: STM32CubeMX.exe; Linux: STM32CubeMX), shared by workspaces on this machine. Detected automatically on Windows and Linux."
        },
        "emberprobe.probeSerial": {
          "type": "string",
          "default": "",
          "description": "高级覆盖：J-Link 序列号。留空时自动选择唯一设备或工作区成功绑定；不会回退到其他设备。"
        },
        "emberprobe.adapterSpeedKhz": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0,
          "description": "调试链路时钟（kHz）；0 使用 OpenOCD 脚本默认值，不是变量采样频率。"
        },
        "emberprobe.transport": {
          "type": "string",
          "enum": [
            "auto",
            "swd",
            "jtag",
            "hla_swd",
            "hla_jtag"
          ],
          "default": "auto",
          "description": "高级覆盖：OpenOCD 传输协议。J-Link auto 复用有效成功记录，已知 Cortex-M 默认 SWD，其他目标采用接口脚本默认协议；不自动切换重试。"
        },
        "emberprobe.rtos": {
          "type": "string",
          "enum": [
            "",
            "auto",
            "none",
            "FreeRTOS",
            "ThreadX",
            "chibios",
            "Chromium-EC",
            "eCos",
            "embKernel",
            "linux",
            "mqx",
            "nuttx",
            "RIOT",
            "uCOS-III",
            "Zephyr"
          ],
          "default": "",
          "description": "高级覆盖：调试时让 OpenOCD 感知的 RTOS（名称区分大小写）。留空表示关闭（默认），调用栈保持单线程；填写后调用栈显示 RTOS 任务，栈帧、变量与单步都绑定到对应任务。仅作用于调试模式，在 target 配置加载后、init 之前写入当前 target，因此改动在下次启动调试时生效；launch.json 的 rtos 优先于此设置。"
        },
        "emberprobe.gdbPath": {
          "type": "string",
          "default": "",
          "description": "ARM GDB executable path."
        },
        "emberprobe.armToolchainPath": {
          "type": "string",
          "default": "",
          "description": "ARM toolchain bin directory."
        },
        "emberprobe.armToolchainPrefix": {
          "type": "string",
          "default": "",
          "description": "Toolchain prefix; defaults to arm-none-eabi."
        },
        "emberprobe.objdumpPath": {
          "type": "string",
          "default": "",
          "description": "ARM objdump executable path."
        },
        "emberprobe.enablePrettyPrinting": {
          "type": "boolean",
          "default": true,
          "description": "Enable built-in libstdc++ STL display in paused variables, watches and hovers. No Python is required."
        },
        "emberprobe.prettyPrinterPath": {
          "type": "string",
          "default": "",
          "description": "Deprecated and ignored: STL display is implemented inside EmberProbe.",
          "deprecationMessage": "Python printers are no longer used. Remove this setting."
        }
      }
    },
    "debuggers": [
      {
        "type": "emberprobe",
        "label": "EmberProbe",
        "languages": [
          "c",
          "cpp",
          "asm"
        ],
        "program": "./dist/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "executable": {
                "type": "string",
                "description": "ELF file; defaults to the selected workspace ELF."
              },
              "cwd": {
                "type": "string"
              },
              "gdbPath": {
                "type": "string"
              },
              "runToEntryPoint": {
                "type": "string",
                "default": "main",
                "description": "Launch/restart entry point; empty keeps the target halted."
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "rtos": {
                "type": "string",
                "enum": [
                  "",
                  "auto",
                  "none",
                  "FreeRTOS",
                  "ThreadX",
                  "chibios",
                  "Chromium-EC",
                  "eCos",
                  "embKernel",
                  "linux",
                  "mqx",
                  "nuttx",
                  "RIOT",
                  "uCOS-III",
                  "Zephyr"
                ],
                "default": "",
                "description": "RTOS for OpenOCD task awareness. Empty keeps the single-thread behavior; a session value overrides the emberprobe.rtos setting."
              },
              "enablePrettyPrinting": {
                "type": "boolean",
                "description": "Override emberprobe.enablePrettyPrinting for this session."
              },
              "prettyPrinterPath": {
                "type": "string",
                "description": "Deprecated and ignored. EmberProbe uses built-in STL display.",
                "deprecationMessage": "Python printers are no longer used."
              }
            }
          },
          "attach": {
            "properties": {
              "executable": {
                "type": "string",
                "description": "ELF file; defaults to the selected workspace ELF."
              },
              "cwd": {
                "type": "string"
              },
              "gdbPath": {
                "type": "string"
              },
              "runToEntryPoint": {
                "type": "string",
                "default": "main",
                "description": "Launch/restart entry point; empty keeps the target halted."
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "rtos": {
                "type": "string",
                "enum": [
                  "",
                  "auto",
                  "none",
                  "FreeRTOS",
                  "ThreadX",
                  "chibios",
                  "Chromium-EC",
                  "eCos",
                  "embKernel",
                  "linux",
                  "mqx",
                  "nuttx",
                  "RIOT",
                  "uCOS-III",
                  "Zephyr"
                ],
                "default": "",
                "description": "RTOS for OpenOCD task awareness. Empty keeps the single-thread behavior; a session value overrides the emberprobe.rtos setting."
              },
              "enablePrettyPrinting": {
                "type": "boolean",
                "description": "Override emberprobe.enablePrettyPrinting for this session."
              },
              "prettyPrinterPath": {
                "type": "string",
                "description": "Deprecated and ignored. EmberProbe uses built-in STL display.",
                "deprecationMessage": "Python printers are no longer used."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "emberprobe",
            "request": "launch",
            "name": "EmberProbe: Launch",
            "runToEntryPoint": "main"
          }
        ],
        "configurationSnippets": [
          {
            "label": "EmberProbe: launch",
            "body": {
              "type": "emberprobe",
              "request": "launch",
              "name": "EmberProbe: launch"
            }
          },
          {
            "label": "EmberProbe: attach",
            "body": {
              "type": "emberprobe",
              "request": "attach",
              "name": "EmberProbe: attach"
            }
          }
        ]
      }
    ]
  },
  "files": [
    "dist/extension.js",
    "dist/buildInfo.json",
    "dist/samplingWorker.js",
    "dist/sampling-timer/**/*",
    "dist/elfWorker.js",
    "dist/webview/**/*",
    "src/webview/**/*",
    "resources/**/*.tar.gz",
    "resources/driver-helper/win32-x64/*",
    "media/**/*",
    "skills/**/*",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "native/vendor/libwdi/COPYING",
    "native/vendor/libwdi/COPYING-LGPL",
    "dist/debugAdapter.js",
    "dist/svdWorker.js"
  ],
  "scripts": {
    "test": "npm run check",
    "check": "node scripts/run-tests.js",
    "check:release": "node scripts/run-tests.js --release",
    "lint": "eslint src skills scripts test",
    "format": "prettier --write \"src/**/*.js\" \"skills/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \".github/workflows/*.yml\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"skills/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \".github/workflows/*.yml\" \"*.json\"",
    "typecheck": "tsc -p jsconfig.quality.json",
    "coverage": "c8 node scripts/run-tests.js --quality && node scripts/check-coordinator-coverage.js",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm run coverage",
    "test:e2e": "npm run bundle && node test/e2e/runTest.js",
    "test:hil": "node test/hil/run-hil.js",
    "release:prepare": "node scripts/release.js",
    "bundle": "node esbuild.js",
    "vscode:prepublish": "npm run bundle",
    "package": "npx --yes @vscode/vsce@3.9.1 package --out dist/emberprobe.vsix",
    "check:syntax": "node scripts/run-tests.js --syntax",
    "test:unit": "node scripts/run-tests.js --tests"
  },
  "dependencies": {
    "@vscode/debugadapter": "1.68.0",
    "fast-xml-parser": "^5.11.0",
    "fzstd": "^0.1.1",
    "koffi": "3.3.1",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "yaml": "2.9.0",
    "yazl": "^3.3.1"
  }
}
