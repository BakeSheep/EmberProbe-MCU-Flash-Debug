{
  "name": "emberprobe",
  "displayName": "EmberProbe - MCU Flash & Debug",
  "description": "Modern MCU flashing and debugging with OpenOCD, automatic target detection, live variables, and Agent Skills.",
  "version": "0.8.2",
  "publisher": "BakeSheep",
  "repository": {
    "type": "git",
    "url": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug.git"
  },
  "homepage": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug#readme",
  "bugs": {
    "url": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "MCU",
    "OpenOCD",
    "flash",
    "debug",
    "ELF",
    "SVD",
    "Cortex-M",
    "embedded",
    "agent"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "EmberProbe executes the configured OpenOCD tool and hardware scripts, so the workspace must be trusted."
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.agents/skills/mcu-variables/SKILL.md",
    "onView:mcu-vscode.mainView",
    "onDebugResolve:cortex-debug",
    "onCommand:mcu-vscode.folderDebug",
    "onCommand:mcu-vscode.folderDownload",
    "onCommand:mcu-vscode.openLiveWatch",
    "onCommand:mcu-vscode.manageAgentSkills",
    "onCommand:mcu-vscode.downloadOfficialSvd",
    "onCommand:mcu-vscode.selectExistingSvd",
    "onCommand:mcu-vscode.switchWorkspaceSvd",
    "onCommand:mcu-vscode.checkOpenOcd",
    "onDebugResolve:emberprobe"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcu-vscode-container",
          "title": "EmberProbe",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "mcu-vscode-container": [
        {
          "type": "webview",
          "id": "mcu-vscode.mainView",
          "name": "Flash & Debug"
        }
      ]
    },
    "commands": [
      {
        "command": "mcu-vscode.folderDebug",
        "title": "EmberProbe: 启动调试"
      },
      {
        "command": "mcu-vscode.folderDownload",
        "title": "EmberProbe: 下载程序"
      },
      {
        "command": "mcu-vscode.openLiveWatch",
        "title": "EmberProbe: 实时变量查看"
      },
      {
        "command": "mcu-vscode.checkOpenOcd",
        "title": "EmberProbe: 检查 OpenOCD 环境"
      },
      {
        "command": "mcu-vscode.manageAgentSkills",
        "title": "EmberProbe: 管理 Agent Skills"
      },
      {
        "command": "mcu-vscode.downloadOfficialSvd",
        "title": "EmberProbe: 下载/配置官方 SVD"
      },
      {
        "command": "mcu-vscode.selectExistingSvd",
        "title": "EmberProbe: 选择已有 SVD"
      },
      {
        "command": "mcu-vscode.switchWorkspaceSvd",
        "title": "EmberProbe: 切换当前工作区 SVD"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mcu-vscode.folderDebug",
          "group": "mcu-vscode@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "mcu-vscode.folderDownload",
          "group": "mcu-vscode@2",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "EmberProbe 配置",
      "properties": {
        "emberprobe.openocdPath": {
          "type": "string",
          "default": "openocd",
          "description": "OpenOCD >= 0.12.0 可执行文件路径；不在 PATH 时请填写绝对路径（如 /usr/bin/openocd 或 C:\\openocd\\bin\\openocd.exe）"
        },
        "emberprobe.tclPort": {
          "type": "number",
          "default": 6666,
          "description": "实时变量采样使用的 OpenOCD Tcl-RPC 端口；显式配置后固定使用该端口，未显式配置时自动选用随机临时端口（OpenOCD Tcl 端口无认证，建议保持随机）"
        },
        "emberprobe.sampleIntervalMs": {
          "type": "number",
          "default": 33,
          "minimum": 5,
          "maximum": 10000,
          "description": "旧版实时变量采样目标间隔（毫秒）；未设置采样频率时仍兼容此设置"
        },
        "emberprobe.sampleFrequencyHz": {
          "type": "number",
          "default": 30,
          "minimum": 0.1,
          "maximum": 200,
          "description": "波形窗口目标采样频率（Hz），默认 30Hz；插件侧栏固定目标 20Hz，实际频率受探针吞吐能力调控"
        },
        "emberprobe.maxSamples": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 360001,
          "deprecationMessage": "此设置已弃用，波形历史统一保留最近 30 分钟；原配置值不会被删除。",
          "description": "已弃用；不再限制波形历史点数"
        },
        "emberprobe.chartHistoryMaxMiB": {
          "type": "number",
          "default": 512,
          "minimum": 64,
          "maximum": 4096,
          "description": "波形历史内存预算（MiB），包含冻结历史；耗尽时暂停全局采样并保留磁盘归档"
        },
        "emberprobe.samplingArchiveMaxMiB": {
          "type": "number",
          "default": 1024,
          "minimum": 64,
          "maximum": 102400,
          "description": "当前扩展会话的自动采样历史最大磁盘占用（MiB），退出时自动删除"
        },
        "emberprobe.cubemxPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Standalone STM32CubeMX executable path (Windows: STM32CubeMX.exe; Linux: STM32CubeMX), shared by workspaces on this machine. Detected automatically on Windows and Linux."
        },
        "emberprobe.probeSerial": {
          "type": "string",
          "default": "",
          "description": "探针序列号：支持 CMSIS-DAP/DAPLink、ST-Link 和 J-Link。DAP/ST-Link 保留大小写及前导零；留空时选择唯一设备或工作区成功绑定，多设备须选择，不会回退到其他设备。"
        },
        "emberprobe.adapterSpeedKhz": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0,
          "description": "调试链路时钟（kHz）；非零值同时限制 target 复位事件的提速，保留事件中的必要降速。0 使用脚本默认值；不是变量采样频率。"
        },
        "emberprobe.transport": {
          "type": "string",
          "enum": [
            "auto",
            "swd",
            "jtag",
            "hla_swd",
            "hla_jtag"
          ],
          "default": "auto",
          "description": "高级覆盖：OpenOCD 传输协议。J-Link auto 复用有效成功记录，已知 Cortex-M 默认 SWD，其他目标采用接口脚本默认协议；不自动切换重试。"
        },
        "emberprobe.rtos": {
          "type": "string",
          "enum": [
            "",
            "auto",
            "none",
            "FreeRTOS",
            "ThreadX",
            "chibios",
            "Chromium-EC",
            "eCos",
            "embKernel",
            "linux",
            "mqx",
            "nuttx",
            "RIOT",
            "uCOS-III",
            "Zephyr"
          ],
          "default": "",
          "description": "高级覆盖：调试时让 OpenOCD 感知的 RTOS（名称区分大小写）。留空表示关闭（默认），调用栈保持单线程；填写后调用栈显示 RTOS 任务，栈帧、变量与单步都绑定到对应任务。仅作用于调试模式，在 target 配置加载后、init 之前写入当前 target，因此改动在下次启动调试时生效；调试会话内的“重启”会复用同一个 OpenOCD 服务，不会重新配置，需停止后重新启动。launch.json 的 rtos 优先于此设置。"
        },
        "emberprobe.gdbPath": {
          "type": "string",
          "default": "",
          "description": "ARM GDB executable path."
        },
        "emberprobe.armToolchainPath": {
          "type": "string",
          "default": "",
          "description": "ARM toolchain bin directory."
        },
        "emberprobe.armToolchainPrefix": {
          "type": "string",
          "default": "",
          "description": "Toolchain prefix; defaults to arm-none-eabi."
        },
        "emberprobe.objdumpPath": {
          "type": "string",
          "default": "",
          "description": "ARM objdump executable path."
        },
        "emberprobe.enablePrettyPrinting": {
          "type": "boolean",
          "default": true,
          "description": "Legacy display switch: false selects raw when prettyPrintingMode is not explicitly configured."
        },
        "emberprobe.prettyPrintingMode": {
          "type": "string",
          "enum": [
            "builtin",
            "gdb",
            "raw"
          ],
          "default": "builtin",
          "description": "Paused C++ display: builtin requires no Python; gdb loads only explicit prettyPrinterFiles; raw shows physical fields."
        },
        "emberprobe.prettyPrinterFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "default": [],
          "description": "Explicit Python printer scripts for gdb mode. Relative paths resolve against the debug cwd; scripts execute inside GDB."
        },
        "emberprobe.prettyPrinterPath": {
          "type": "string",
          "default": "",
          "description": "Deprecated and ignored: STL display is implemented inside EmberProbe.",
          "deprecationMessage": "Use prettyPrinterFiles with prettyPrintingMode=gdb for explicit Python scripts."
        },
        "emberprobe.memory.regionKinds": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "flash",
              "ram",
              "other"
            ]
          },
          "markdownDescription": "Override memory region types by their exact linker names, e.g. {\"APP_STORAGE\":\"flash\",\"FAST_HEAP\":\"ram\"}. Capacities come from the project .map or .ld file."
        },
        "emberprobe.experimental.externalGdb.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Experimental: allow explicit EmberProbe external attach configurations. After use, stop the external server and disable this setting to release the probe hold. Existing debug buttons continue to use OpenOCD."
        },
        "emberprobe.experimental.externalGdb.target": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Experimental external GDB TCP target: host:port or [IPv6]:port. Required for explicit external attach; the server must already be running."
        },
        "emberprobe.experimental.externalGdb.connectionMode": {
          "type": "string",
          "enum": [
            "remote",
            "extended-remote"
          ],
          "default": "extended-remote",
          "scope": "resource",
          "description": "Experimental external GDB connection mode. Read at attach startup; changing it does not redirect an active session."
        }
      }
    },
    "debuggers": [
      {
        "type": "emberprobe",
        "label": "EmberProbe",
        "languages": [
          "c",
          "cpp",
          "asm"
        ],
        "program": "./dist/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "performanceTrace": {
                "type": "boolean",
                "default": false,
                "description": "Log native DAP queue time, duration and MI command counts without expression contents."
              },
              "servertype": {
                "type": "string",
                "enum": [
                  "openocd"
                ],
                "description": "Managed debug server backend."
              },
              "serverpath": {
                "type": "string",
                "description": "Override the OpenOCD executable; paths resolve against debug cwd."
              },
              "numberOfProcessors": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32,
                "description": "Experimental target selection: expected count of OpenOCD targets."
              },
              "targetProcessor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31,
                "description": "Zero-based index in OpenOCD target names; must be less than numberOfProcessors."
              },
              "targetName": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
                "description": "Expected target name at targetProcessor; a mismatch fails startup."
              },
              "executable": {
                "type": "string",
                "description": "ELF file; defaults to the selected workspace ELF."
              },
              "cwd": {
                "type": "string"
              },
              "gdbPath": {
                "type": "string"
              },
              "runToEntryPoint": {
                "type": "string",
                "default": "main",
                "description": "Launch/restart entry point; empty keeps the target halted."
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "rtos": {
                "type": "string",
                "enum": [
                  "",
                  "auto",
                  "none",
                  "FreeRTOS",
                  "ThreadX",
                  "chibios",
                  "Chromium-EC",
                  "eCos",
                  "embKernel",
                  "linux",
                  "mqx",
                  "nuttx",
                  "RIOT",
                  "uCOS-III",
                  "Zephyr"
                ],
                "default": "",
                "description": "RTOS for OpenOCD task awareness. Empty keeps the single-thread behavior; a session value overrides the emberprobe.rtos setting."
              },
              "enablePrettyPrinting": {
                "type": "boolean",
                "description": "Override emberprobe.enablePrettyPrinting for this session."
              },
              "prettyPrintingMode": {
                "type": "string",
                "enum": [
                  "builtin",
                  "gdb",
                  "raw"
                ],
                "description": "Override the paused C++ display mode for this session."
              },
              "prettyPrinterFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32,
                "description": "Explicit Python printer scripts, loaded only in gdb mode."
              },
              "prettyPrinterPath": {
                "type": "string",
                "description": "Deprecated and ignored. EmberProbe uses built-in STL display.",
                "deprecationMessage": "Use prettyPrinterFiles with prettyPrintingMode=gdb."
              },
              "symbolFiles": {
                "type": "array",
                "maxItems": 32,
                "description": "Ordered symbol images. First is primary; omitted uses executable; [] loads no symbols. Paths resolve against cwd.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "file"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "offset": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": -4294967295,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^-?(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        },
                        "textaddress": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        },
                        "sections": {
                          "type": "array",
                          "maxItems": 128,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "name",
                              "address"
                            ],
                            "properties": {
                              "name": {
                                "type": "string",
                                "pattern": "^[.\\w$][.\\w$-]{0,127}$"
                              },
                              "address": {
                                "oneOf": [
                                  {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 4294967295
                                  },
                                  {
                                    "type": "string",
                                    "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "loadFiles": {
                "type": "array",
                "maxItems": 32,
                "description": "Launch downloads in order. Omitted uses executable; [] skips downloads. Attach never downloads. BIN requires address; ELF/HEX accept offset.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "file"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "format": {
                          "type": "string",
                          "enum": [
                            "elf",
                            "hex",
                            "bin"
                          ]
                        },
                        "address": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        },
                        "offset": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": -4294967295,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^-?(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              "preLaunchCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands before managed launch commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "postLaunchCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands after managed launch commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "preAttachCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands before managed attach commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "postAttachCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands after managed attach commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "preResetCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands before managed reset commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "postResetCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands after managed reset commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "serverGroup": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                "description": "Experimental shared OpenOCD group. Requires numberOfProcessors >= 2. Start the first core, then attach other cores with matching physical settings; stop all members before resetting."
              }
            }
          },
          "attach": {
            "properties": {
              "performanceTrace": {
                "type": "boolean",
                "default": false,
                "description": "Log native DAP queue time, duration and MI command counts without expression contents."
              },
              "servertype": {
                "type": "string",
                "enum": [
                  "openocd",
                  "external"
                ],
                "description": "Debug backend. Experimental external attach requires native VS Code settings and an already running TCP server."
              },
              "serverpath": {
                "type": "string",
                "description": "Override the OpenOCD executable; paths resolve against debug cwd."
              },
              "numberOfProcessors": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32,
                "description": "Experimental target selection: expected count of OpenOCD targets."
              },
              "targetProcessor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31,
                "description": "Zero-based index in OpenOCD target names; must be less than numberOfProcessors."
              },
              "targetName": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
                "description": "Expected target name at targetProcessor; a mismatch fails startup."
              },
              "executable": {
                "type": "string",
                "description": "ELF file; defaults to the selected workspace ELF."
              },
              "cwd": {
                "type": "string"
              },
              "gdbPath": {
                "type": "string"
              },
              "runToEntryPoint": {
                "type": "string",
                "default": "main",
                "description": "Launch/restart entry point; empty keeps the target halted."
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "rtos": {
                "type": "string",
                "enum": [
                  "",
                  "auto",
                  "none",
                  "FreeRTOS",
                  "ThreadX",
                  "chibios",
                  "Chromium-EC",
                  "eCos",
                  "embKernel",
                  "linux",
                  "mqx",
                  "nuttx",
                  "RIOT",
                  "uCOS-III",
                  "Zephyr"
                ],
                "default": "",
                "description": "RTOS for OpenOCD task awareness. Empty keeps the single-thread behavior; a session value overrides the emberprobe.rtos setting."
              },
              "enablePrettyPrinting": {
                "type": "boolean",
                "description": "Override emberprobe.enablePrettyPrinting for this session."
              },
              "prettyPrintingMode": {
                "type": "string",
                "enum": [
                  "builtin",
                  "gdb",
                  "raw"
                ],
                "description": "Override the paused C++ display mode for this session."
              },
              "prettyPrinterFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32,
                "description": "Explicit Python printer scripts, loaded only in gdb mode."
              },
              "prettyPrinterPath": {
                "type": "string",
                "description": "Deprecated and ignored. EmberProbe uses built-in STL display.",
                "deprecationMessage": "Use prettyPrinterFiles with prettyPrintingMode=gdb."
              },
              "symbolFiles": {
                "type": "array",
                "maxItems": 32,
                "description": "Ordered symbol images. First is primary; omitted uses executable; [] loads no symbols. Paths resolve against cwd.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "file"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "offset": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": -4294967295,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^-?(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        },
                        "textaddress": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
