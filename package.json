{
  "name": "emberprobe",
  "displayName": "EmberProbe - MCU Flash & Debug",
  "description": "Modern MCU flashing and debugging with OpenOCD, automatic target detection, live variables, and Agent Skills.",
  "version": "0.9.0",
  "publisher": "BakeSheep",
  "repository": {
    "type": "git",
    "url": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug.git"
  },
  "homepage": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug#readme",
  "bugs": {
    "url": "https://github.com/BakeSheep/EmberProbe-MCU-Flash-Debug/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "MCU",
    "OpenOCD",
    "flash",
    "debug",
    "ELF",
    "SVD",
    "Cortex-M",
    "embedded",
    "agent"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "EmberProbe executes the configured OpenOCD tool and hardware scripts, so the workspace must be trusted."
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.agents/skills/mcu-variables/SKILL.md",
    "onView:mcu-vscode.mainView",
    "onCommand:mcu-vscode.folderDebug",
    "onCommand:mcu-vscode.folderAttachDebug",
    "onCommand:mcu-vscode.folderDownload",
    "onCommand:mcu-vscode.openLiveWatch",
    "onWebviewPanel:emberprobe.liveWatch",
    "onCommand:mcu-vscode.manageAgentSkills",
    "onCommand:mcu-vscode.installMcpServer",
    "onCommand:mcu-vscode.enableAgentAccess",
    "onCommand:mcu-vscode.disableAgentAccess",
    "onCommand:mcu-vscode.downloadOfficialSvd",
    "onCommand:mcu-vscode.selectExistingSvd",
    "onCommand:mcu-vscode.switchWorkspaceSvd",
    "onCommand:mcu-vscode.checkOpenOcd",
    "onDebugResolve:emberprobe"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "emberprobe",
        "label": "EmberProbe"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcu-vscode-container",
          "title": "EmberProbe",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "mcu-vscode-container": [
        {
          "type": "webview",
          "id": "mcu-vscode.mainView",
          "name": "Flash & Debug"
        }
      ]
    },
    "commands": [
      {
        "command": "mcu-vscode.folderDebug",
        "title": "EmberProbe: 启动调试"
      },
      {
        "command": "mcu-vscode.folderAttachDebug",
        "title": "EmberProbe: 不复位调试（保留现场）"
      },
      {
        "command": "mcu-vscode.folderDownload",
        "title": "EmberProbe: 下载程序"
      },
      {
        "command": "mcu-vscode.openLiveWatch",
        "title": "EmberProbe: 实时变量查看"
      },
      {
        "command": "mcu-vscode.selectChartBackgroundIcon",
        "title": "EmberProbe: 导入/更换波形背景图标"
      },
      {
        "command": "mcu-vscode.removeChartBackgroundIcon",
        "title": "EmberProbe: 移除波形背景图标"
      },
      {
        "command": "mcu-vscode.checkOpenOcd",
        "title": "EmberProbe: 检查 OpenOCD 环境"
      },
      {
        "command": "mcu-vscode.manageAgentSkills",
        "title": "EmberProbe: 管理 Agent Skills"
      },
      {
        "command": "mcu-vscode.installMcpServer",
        "title": "EmberProbe: 安装 MCP 服务器到客户端"
      },
      {
        "command": "mcu-vscode.enableAgentAccess",
        "title": "EmberProbe: 为此工作区启用 Agent 访问"
      },
      {
        "command": "mcu-vscode.disableAgentAccess",
        "title": "EmberProbe: 为此工作区停用 Agent 访问"
      },
      {
        "command": "mcu-vscode.downloadOfficialSvd",
        "title": "EmberProbe: 下载/配置官方 SVD"
      },
      {
        "command": "mcu-vscode.selectExistingSvd",
        "title": "EmberProbe: 选择已有 SVD"
      },
      {
        "command": "mcu-vscode.switchWorkspaceSvd",
        "title": "EmberProbe: 切换当前工作区 SVD"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mcu-vscode.folderDebug",
          "group": "mcu-vscode@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "mcu-vscode.folderAttachDebug",
          "group": "mcu-vscode@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "mcu-vscode.folderDownload",
          "group": "mcu-vscode@2",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": [
      {
        "id": "emberprobe.tools",
        "title": "EmberProbe: 工具与路径 / Tools & Paths",
        "order": 1,
        "properties": {
          "emberprobe.openocdPath": {
            "type": "string",
            "default": "openocd",
            "description": "OpenOCD 可执行文件路径。默认在 Windows/Linux x64 使用内置版本；使用外部版本时填写 OpenOCD ≥ 0.12.0 的绝对路径。 / OpenOCD executable path. Uses the bundled version on Windows/Linux x64 by default; enter an absolute path to use external OpenOCD ≥ 0.12.0.",
            "order": 1
          },
          "emberprobe.gdbPath": {
            "type": "string",
            "default": "",
            "description": "ARM GDB 可执行文件路径。 / ARM GDB executable path.",
            "order": 2
          },
          "emberprobe.armToolchainPath": {
            "type": "string",
            "default": "",
            "description": "ARM 工具链的 bin 目录。 / ARM toolchain bin directory.",
            "order": 3
          },
          "emberprobe.armToolchainPrefix": {
            "type": "string",
            "default": "",
            "description": "ARM 工具链前缀，留空使用 arm-none-eabi。 / ARM toolchain prefix; leave empty to use arm-none-eabi.",
            "order": 4
          },
          "emberprobe.objdumpPath": {
            "type": "string",
            "default": "",
            "description": "ARM objdump 可执行文件路径。 / ARM objdump executable path.",
            "order": 5
          },
          "emberprobe.cubemxPath": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "description": "独立 STM32CubeMX 可执行文件路径（Windows：STM32CubeMX.exe；Linux：STM32CubeMX）。在用户设置中配置，本机所有工作区共享；留空自动检测。 / Standalone STM32CubeMX executable path (Windows: STM32CubeMX.exe; Linux: STM32CubeMX). Configure in User settings for all workspaces on this machine; leave empty for automatic detection.",
            "order": 6
          },
          "emberprobe.cubemx2Path": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "description": "STM32CubeMX2 启动器路径。在用户设置中配置，本机所有工作区共享；留空时依次通过官方 Cube 注册信息或 Cube CLI、安装目录、PATH 和 Windows 快捷方式检测。 / STM32CubeMX2 launcher path. Configure in User settings for all workspaces on this machine; leave empty to detect via official Cube registration or Cube CLI, then installation directories, PATH and Windows shortcuts.",
            "order": 7
          }
        }
      },
      {
        "id": "emberprobe.connection",
        "title": "EmberProbe: 连接与调试 / Connection & Debugging",
        "order": 2,
        "properties": {
          "emberprobe.tclPort": {
            "type": "number",
            "default": 6666,
            "description": "实时采样的 OpenOCD Tcl-RPC 端口。未显式设置时使用随机临时端口；显式设置后使用固定端口。Tcl 端口无认证，建议保持随机。 / OpenOCD Tcl-RPC port for live sampling. Uses a random ephemeral port unless explicitly configured. Tcl has no authentication; a random port is recommended.",
            "order": 1
          },
          "emberprobe.adapterSpeedKhz": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 0,
            "description": "调试和烧录的链路时钟（kHz）。0 使用脚本默认值，烧录时按探针能力提速，失败自动回退；非零值也限制复位事件提速，保留必要降速。 / Debug and flash adapter clock (kHz). 0 uses the script default and allows faster flashing with automatic fallback; nonzero values also cap reset-event speed increases while preserving required slowdowns.",
            "order": 2
          },
          "emberprobe.transport": {
            "type": "string",
            "enum": [
              "auto",
              "swd",
              "jtag",
              "hla_swd",
              "hla_jtag"
            ],
            "default": "auto",
            "description": "覆盖 OpenOCD 传输协议。auto 下 J-Link 对已知 Cortex-M 目标使用 SWD，其他目标使用接口脚本默认协议；不自动切换重试。 / Override the OpenOCD transport. With auto, J-Link uses SWD for known Cortex-M targets and the interface script default for other targets; no automatic transport retry.",
            "order": 3
          },
          "emberprobe.rtos": {
            "type": "string",
            "enum": [
              "",
              "auto",
              "none",
              "FreeRTOS",
              "ThreadX",
              "chibios",
              "Chromium-EC",
              "eCos",
              "embKernel",
              "linux",
              "mqx",
              "nuttx",
              "RIOT",
              "uCOS-III",
              "Zephyr"
            ],
            "default": "",
            "description": "调试时的 OpenOCD RTOS 感知，名称区分大小写；留空关闭。启用后调用栈显示 RTOS 任务，栈帧、变量和单步绑定对应任务。修改后需停止并重新启动调试；会话内重启不重新配置。launch.json 的 rtos 优先。 / OpenOCD RTOS awareness for debugging; names are case-sensitive and empty disables it. The call stack shows RTOS tasks with task-bound frames, variables and stepping. Stop and start debugging to apply changes; session restart reuses the server. launch.json rtos takes precedence.",
            "order": 4
          },
          "emberprobe.prettyPrintingMode": {
            "type": "string",
            "enum": [
              "builtin",
              "gdb",
              "raw"
            ],
            "default": "builtin",
            "description": "暂停时的 C++ 变量显示：builtin 使用内置解析，无需 Python；gdb 仅加载 prettyPrinterFiles 明确指定的脚本；raw 显示原始字段。 / Paused C++ variable display: builtin uses internal parsing without Python; gdb loads only scripts explicitly listed in prettyPrinterFiles; raw shows physical fields.",
            "order": 5
          },
          "emberprobe.prettyPrinterFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "default": [],
            "description": "gdb 显示模式加载的 Python 打印脚本，最多 32 个。相对路径基于调试工作目录解析；脚本在 GDB 内执行。 / Python printer scripts loaded in gdb display mode, up to 32 files. Relative paths resolve against the debug working directory; scripts execute inside GDB.",
            "order": 6
          }
        }
      },
      {
        "id": "emberprobe.sampling",
        "title": "EmberProbe: 采样与波形 / Sampling & Waveforms",
        "order": 3,
        "properties": {
          "emberprobe.sampleFrequencyHz": {
            "type": "number",
            "default": 30,
            "minimum": 0.1,
            "maximum": 200,
            "description": "波形窗口目标采样频率（Hz），默认 30，范围 0.1–200。侧栏目标固定为 20 Hz；实际速率受探针吞吐能力限制。 / Target waveform sampling frequency (Hz), default 30, range 0.1–200. The sidebar targets a fixed 20 Hz; actual rates depend on probe throughput.",
            "order": 1
          },
          "emberprobe.samplingAdapterSpeedKhz": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 0,
            "description": "独立采样的链路时钟（kHz）。0 沿用 adapterSpeedKhz；非零值只用于独立采样，并限制复位事件提速。修改后自动重连，不改变调试、烧录时钟或采样频率。 / Standalone sampling adapter clock (kHz). 0 inherits adapterSpeedKhz; nonzero values apply only to standalone sampling and cap reset-event speed increases. Changes reconnect sampling without changing debug/flash clocks or sampling frequency.",
            "order": 2
          },
          "emberprobe.chartHistoryMaxMiB": {
            "type": "number",
            "default": 512,
            "minimum": 64,
            "maximum": 4096,
            "description": "波形历史的内存预算（MiB），包含冻结历史。耗尽时暂停全局采样并保留磁盘归档。 / Waveform history memory budget (MiB), including frozen history. Sampling pauses globally when exhausted; disk archives are retained.",
            "order": 3
          },
          "emberprobe.samplingArchiveMaxMiB": {
            "type": "number",
            "default": 1024,
            "minimum": 64,
            "maximum": 102400,
            "description": "当前扩展会话的采样历史磁盘占用上限（MiB）。修改立即生效；调高后可重新开始因写满停止的采样。退出时自动删除归档。 / Sampling history disk limit (MiB) for the current extension session. Changes apply immediately; raising the limit allows sampling stopped by a full archive to restart. Archives are deleted on exit.",
            "order": 4
          },
          "emberprobe.chartBackgroundIcon.enabled": {
            "type": "boolean",
            "default": true,
            "scope": "application",
            "ignoreSync": true,
            "markdownDescription": "在波形背景居中显示淡色图标。[导入/更换 PNG](command:mcu-vscode.selectChartBackgroundIcon) · [移除图标](command:mcu-vscode.removeChartBackgroundIcon)。支持透明底或纯色底 PNG；仅在本地处理，所有项目共享，不保存原图颜色和路径。 / Show a faint centered waveform background icon. [Import/replace PNG](command:mcu-vscode.selectChartBackgroundIcon) · [Remove icon](command:mcu-vscode.removeChartBackgroundIcon). Supports transparent or solid PNG backgrounds; processed locally and shared across projects. Original colors and source paths are not stored.",
            "order": 5
          }
        }
      },
      {
        "id": "emberprobe.experimental",
        "title": "EmberProbe: 实验功能 / Experimental",
        "order": 4,
        "properties": {
          "emberprobe.experimental.externalGdb.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "markdownDescription": "实验性：允许显式配置的外部 GDB 附加。使用后停止外部服务器并关闭此设置，以释放探针占用；现有调试按钮仍使用 OpenOCD。 / Experimental: allow explicitly configured external GDB attach. Stop the external server and disable this setting after use to release the probe hold; existing debug buttons still use OpenOCD.",
            "order": 1
          },
          "emberprobe.experimental.externalGdb.target": {
            "type": "string",
            "default": "",
            "scope": "resource",
            "description": "实验性：外部 GDB TCP 地址，格式为 host:port 或 [IPv6]:port。显式外部附加时必填，服务器须已运行。 / Experimental: external GDB TCP target as host:port or [IPv6]:port. Required for explicit external attach; the server must already be running.",
            "order": 2
          },
          "emberprobe.experimental.externalGdb.connectionMode": {
            "type": "string",
            "enum": [
              "remote",
              "extended-remote"
            ],
            "default": "extended-remote",
            "scope": "resource",
            "description": "实验性：外部 GDB 连接模式，在附加启动时读取。修改不会切换现有会话的连接。 / Experimental: external GDB connection mode, read when attach starts. Changes do not redirect an active session.",
            "order": 3
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "emberprobe",
        "label": "EmberProbe",
        "languages": [
          "c",
          "cpp",
          "asm"
        ],
        "program": "./dist/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "properties": {
              "performanceTrace": {
                "type": "boolean",
                "default": false,
                "description": "Log native DAP queue time, duration and MI command counts, launch phase timings and the time to the entry breakpoint, without expression contents or paths."
              },
              "servertype": {
                "type": "string",
                "enum": [
                  "openocd"
                ],
                "description": "Managed debug server backend."
              },
              "serverpath": {
                "type": "string",
                "description": "Override the OpenOCD executable; paths resolve against debug cwd."
              },
              "numberOfProcessors": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32,
                "description": "Experimental target selection: expected count of OpenOCD targets."
              },
              "targetProcessor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31,
                "description": "Zero-based index in OpenOCD target names; must be less than numberOfProcessors."
              },
              "targetName": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
                "description": "Expected target name at targetProcessor; a mismatch fails startup."
              },
              "executable": {
                "type": "string",
                "description": "ELF file; defaults to the selected workspace ELF."
              },
              "cwd": {
                "type": "string"
              },
              "gdbPath": {
                "type": "string"
              },
              "runToEntryPoint": {
                "type": "string",
                "default": "main",
                "description": "Launch/restart entry point; empty keeps the target halted."
              },
              "sourceFileMap": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "rtos": {
                "type": "string",
                "enum": [
                  "",
                  "auto",
                  "none",
                  "FreeRTOS",
                  "ThreadX",
                  "chibios",
                  "Chromium-EC",
                  "eCos",
                  "embKernel",
                  "linux",
                  "mqx",
                  "nuttx",
                  "RIOT",
                  "uCOS-III",
                  "Zephyr"
                ],
                "default": "",
                "description": "RTOS for OpenOCD task awareness. Empty keeps the single-thread behavior; a session value overrides the emberprobe.rtos setting."
              },
              "prettyPrintingMode": {
                "type": "string",
                "enum": [
                  "builtin",
                  "gdb",
                  "raw"
                ],
                "description": "Override the paused C++ display mode for this session."
              },
              "prettyPrinterFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32,
                "description": "Explicit Python printer scripts, loaded only in gdb mode."
              },
              "symbolFiles": {
                "type": "array",
                "maxItems": 32,
                "description": "Ordered symbol images. First is primary; omitted uses executable; [] loads no symbols. Paths resolve against cwd.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "file"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "offset": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": -4294967295,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^-?(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        },
                        "textaddress": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        },
                        "sections": {
                          "type": "array",
                          "maxItems": 128,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "name",
                              "address"
                            ],
                            "properties": {
                              "name": {
                                "type": "string",
                                "pattern": "^[.\\w$][.\\w$-]{0,127}$"
                              },
                              "address": {
                                "oneOf": [
                                  {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 4294967295
                                  },
                                  {
                                    "type": "string",
                                    "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "loadFiles": {
                "type": "array",
                "maxItems": 32,
                "description": "Launch downloads in order. Omitted uses executable; [] skips downloads. Attach never downloads. BIN requires address; ELF/HEX accept offset.",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "file"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "file": {
                          "type": "string"
                        },
                        "format": {
                          "type": "string",
                          "enum": [
                            "elf",
                            "hex",
                            "bin"
                          ]
                        },
                        "address": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        },
                        "offset": {
                          "oneOf": [
                            {
                              "type": "integer",
                              "minimum": -4294967295,
                              "maximum": 4294967295
                            },
                            {
                              "type": "string",
                              "pattern": "^-?(?:0[xX][0-9a-fA-F]+|[0-9]+)$"
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              "preLaunchCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands before managed launch commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "postLaunchCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands after managed launch commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "preAttachCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands before managed attach commands. Launch/attach hooks run after connection; failures terminate startup."
              },
              "postAttachCommands": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Explicit single-line GDB console commands after managed attach commands. Launch/attach hooks run after connection; failures terminate startup."
              },
