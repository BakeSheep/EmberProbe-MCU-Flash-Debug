{
  "all": true,
  "include": ["src/**/*.js", "skills/**/*.js", "scripts/**/*.js", "test/hil/run-hil.js"],
  "exclude": [
    "test/**",
    "src/extension.js",
    "src/mainViewProvider.js",
    "src/modernView.js",
    "src/liveWatchView.js",
    "src/autoDetect.js",
    "src/chipInfo.js",
    "src/openocdInstaller.js",
    "src/webview/**/renderer.js",
    "src/webview/liveWatch/viewport.js",
    "src/i18n/**/*.js",
    "scripts/extract-webview-assets.js",
    "scripts/split-i18n.js"
  ],
  "reporter": ["text", "json-summary"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 80,
  "functions": 75,
  "branches": 65,
  "statements": 80
}
