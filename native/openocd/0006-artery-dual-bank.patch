+/* The Bank 2 unlock, status, control, and address registers are banked.
+ * Device and user-system-data registers still belong to the controller.
+ */
+#define ARTERY_DUAL_BANK_SIZE (512 * 1024)
+#define ARTERY_DUAL_BANK2_BASE (FLASH_BASE + ARTERY_DUAL_BANK_SIZE)
+
+static uint32_t artery_flash_register_address(struct flash_bank *bank,
+		enum artery_flash_reg_index reg)
+{
+	const struct artery_flash_bank *info = bank->driver_priv;
+	const struct artery_series_info *series = &artery_series[info->part_info->series];
+	uint32_t address = series->flash_regs_base + series->flash_regs[reg];
+	if (bank->driver == &artery_dual_flash && bank->base == ARTERY_DUAL_BANK2_BASE) {
+		switch (reg) {
+		case ARTERY_FLASH_REG_UNLOCK:
+		case ARTERY_FLASH_REG_STS:
+		case ARTERY_FLASH_REG_CTRL:
+		case ARTERY_FLASH_REG_ADDR:
+			address += 0x40;
+			break;
+		default:
+			break;
+		}
+	}
+	return address;
+}
+
 static int artery_read_flash_register(struct flash_bank *bank,
 		enum artery_flash_reg_index reg, uint32_t *value)
 {
-	const struct artery_flash_bank *artery_info = bank->driver_priv;
-	const struct artery_part_info *part_info = artery_info->part_info;
-	const struct artery_series_info *series_info = &artery_series[part_info->series];
-	uint32_t reg_addr = series_info->flash_regs_base + series_info->flash_regs[reg];
+	uint32_t reg_addr = artery_flash_register_address(bank, reg);
 
